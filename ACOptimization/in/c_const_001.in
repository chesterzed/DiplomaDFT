&CONTROL
  calculation = 'relax',
  etot_conv_thr = 1d-05,
  forc_conv_thr = 0.001,
  outdir = './ACOptimization/out',
  prefix = 'c_const',
  pseudo_dir = './pseudo',
  title = 'Optimisation A C for MgNi2',
  wf_collect = .FALSE.,
/
&SYSTEM
  celldm(1) = 4.824,
  celldm(3) = 3.018225538971808,
  degauss = 0.02,
  ecutrho = 400,
  ecutwfc = 50,
  ibrav = 4,
  lspinorb = .TRUE.,
  noncolin = .TRUE.,
  occupations = 'smearing',
  smearing = 'm-v',
  nat = 24,
  ntyp = 2,
/
&ELECTRONS
  conv_thr = 1d-08,
  diagonalization = 'david',
  electron_maxstep = 120,
  mixing_beta = 0.4,
  mixing_mode = 'plain',
  mixing_ndim = 15,
/
&IONS
  ion_dynamics = 'bfgs',
/
&CELL
  cell_dofree = 'all',
  cell_dynamics = 'bfgs',
/
